# Copy to .env and fill in. Public Mapbox token starts with pk.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Supabase: Project Settings > API Keys. Use the PUBLISHABLE key (sb_publishable_...). Never the secret / service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Google sign-in: the WEB client ID from Google Cloud (Google Auth Platform > Clients). Not secret.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
